# Xcode
build/
build-release/
build-test/
DerivedData/
.build/

# Release artifacts. Since 0.3.1 the zip carries a 38 MB offline core, which does
# not delta-compress — the repo would grow by the size of every release. Attach
# dist/ to the remote's Release page instead.
dist/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcuserdata/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/
.package.resolved
Package.resolved


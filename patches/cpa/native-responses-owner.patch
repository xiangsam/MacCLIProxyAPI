+
+// The executor/protocol remains Codex; model ownership follows the configured upstream.
+// Unknown gateways keep their hostname rather than pretending to be OpenAI.
+func nativeResponsesOwner(baseURL string) string {
+	if strings.TrimSpace(baseURL) == "" {
+		return "openai"
+	}
+	parsed, err := url.Parse(strings.TrimSpace(baseURL))
+	if err != nil || parsed.Hostname() == "" {
+		return "unknown"
+	}
+	host := strings.ToLower(parsed.Hostname())
+	if host == "openai.com" || strings.HasSuffix(host, ".openai.com") || host == "chatgpt.com" || strings.HasSuffix(host, ".chatgpt.com") {
+		return "openai"
+	}
+	if host == "deepseek.com" || strings.HasSuffix(host, ".deepseek.com") {
+		return "deepseek"
+	}
+	return host
+}
diff --git a/sdk/cliproxy/mac_native_owner_test.go b/sdk/cliproxy/mac_native_owner_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/mac_native_owner_test.go
@@ -0,0 +1,26 @@
+package cliproxy
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"testing"
+)
+
+func TestMacNativeResponsesOwnership(t *testing.T) {
+	for _, tc := range []struct{ base, owner string }{
+		{"", "openai"}, {"https://api.openai.com/v1", "openai"},
+		{"https://chatgpt.com/backend-api", "openai"},
+		{"https://api.deepseek.com/v1", "deepseek"},
+		{"https://api.deepseek.com.evil.example", "api.deepseek.com.evil.example"},
+		{"https://gateway.example/v1", "gateway.example"},
+	} {
+		entry := &config.CodexKey{BaseURL: tc.base, Models: []config.CodexModel{{Name: "deepseek-v4-flash", Alias: "fast"}}}
+		models := buildCodexConfigModels(entry)
+		if len(models) != 1 || models[0].OwnedBy != tc.owner || models[0].Type != "openai" || models[0].ID != "fast" {
+			t.Fatalf("base %s: unexpected model metadata: %+v", tc.base, models)
+		}
+	}
+	entry := &config.CodexKey{BaseURL: "https://gateway.example", Models: []config.CodexModel{{Name: "model", OwnedBy: "DeepSeek"}}}
+	if got := buildCodexConfigModels(entry)[0].OwnedBy; got != "DeepSeek" {
+		t.Fatalf("explicit owner = %s", got)
+	}
+}
